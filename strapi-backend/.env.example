# ═══════════════════════════════════════════════════════════════════════════
#  Bibliothèque Numérique MTeFOP — Strapi 5
#  Modèle de configuration. COPIEZ CE FICHIER EN `.env` ET RENSEIGNEZ LES
#  VALEURS. AUCUN secret réel ici : ne committez jamais un .env rempli.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Serveur Strapi ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
# Liste de clés séparées par des virgules — À REMPLACER (>= 32 caractères chacune)
APP_KEYS=changez-cle1,changez-cle2,changez-cle3,changez-cle4
JWT_SECRET=changez-jwt-secret
ADMIN_JWT_SECRET=changez-admin-jwt-secret
TRANSFER_TOKEN_SALT=changez-transfer-salt
API_TOKEN_SALT=changez-api-token-salt
ENCRYPTION_KEY=changez-encryption-key

# ─── Base de données (défaut : SQLite) ──────────────────────────────────────
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=digitallibrary_db1
# DB_USER=postgres
# DB_PASSWORD=

# ─── URL publique du FRONT — LIENS DES E-MAILS (OBLIGATOIRE en production) ──
# Confirmation d'abonnement, désabonnement, fiches /documents/:id, actus.
# En production, cette valeur ne doit PAS être localhost, sinon les liens des
# e-mails seront faux (Strapi affiche un BANNIER d'erreur au démarrage).
FRONTEND_URL=http://localhost:5173
# Production : FRONTEND_URL=https://votre-domaine.example
#
# ── Tester les liens des e-mails depuis un autre appareil (téléphone, autre
#    PC) — À CONFIGURER VOUS-MÊME, aucune donnée à changer ici :
#  • localhost ne fonctionne QUE sur la machine qui héberge l'application ;
#  • pour un autre appareil du même réseau : mettre FRONTEND_URL sur l'adresse
#    IP locale (ex. http://192.168.1.10:5173), lancer Vite avec
#    `npm run dev -- --host` (serveur exposé sur le réseau), vérifier que
#    l'API Strapi (port 1337) est joignable depuis cet appareil et ajouter
#    cette origine à la liste CORS de config/middlewares.ts ;
#  • hors réseau local : utiliser un tunnel (Cloudflare Tunnel, ngrok) ou un
#    vrai hébergement, puis pointer FRONTEND_URL sur l'URL publique obtenue.

# ─── Expéditeur des e-mails ─────────────────────────────────────────────────
SITE_NAME=Bibliothèque Numérique MTeFOP
# L'adresse expéditeur doit appartenir au domaine déclaré en production
# (voir SPF/DKIM/DMARC — recommandations mise en ligne) :
EMAIL_FROM=Bibliothèque Numérique MTeFOP <no-reply@votre-domaine.example>

# ═══════════════════════════════════════════════════════════════════════════
#  SMTP — 3 options (n'en cochez qu'une)
#  Toutes les variables SMTP_* sont prioritaires sur leurs alias EMAIL_*.
# ═══════════════════════════════════════════════════════════════════════════

# ─── OPTION A (recommandée pour le réel) : relais SMTP d'un service
#     transactionnel. L'application parle SMTP standard (nodemailer) : il faut
#     un fournisseur exposant host/port/user/pass (« SMTP relay »). Le choix du
#     fournisseur se fait à la mise en ligne (délivrabilité SPF/DKIM requise).
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp-relay.votre-fournisseur.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cle-api-ou-utilisateur
# SMTP_PASS=cle-api-ou-mot-de-passe
# Aliases acceptés à la place : EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASSWORD

# ─── OPTION B (démonstration / soutenance) : Gmail + mot de passe d'application
#     Limite ~500 e-mails/jour. Créer un mot de passe d'application dans le
#     compte Google (Sécurité → Validation en 2 étapes → Mots de passe
#     d'application) — JAMAIS le mot de passe principal, JAMAIS committez-le.
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
#
# ⚠️  LES 3 PIÈGES GMAIL (lisez-les avant de chercher plus loin) :
#  1. Validation en 2 étapes OBLIGATOIRE + « mot de passe d'application »
#     (compte Google → Sécurité → Validation en 2 étapes → Mots de passe
#     d'application), SAISI SANS ESPACES. Le mot de passe normal est refusé
#     (erreur 535). SMTP_USER/SMTP_PASS sont prioritaires sur EMAIL_USER/
#     EMAIL_PASSWORD, qui sont acceptés comme alias.
#  2. REDÉMARRAGE OBLIGATOIRE : Strapi lit .env (dossier strapi-backend/) une
#     seule fois, à son démarrage. Toute modification demande un redémarrage
#     (`npm run dev`). Un .env placé ailleurs qu'à strapi-backend/.env est
#     ignoré. Au démarrage, vérifiez la ligne « Mailer ACTIF » / « Mailer
#     INACTIF : variable(s) manquante(s) : … » dans la console.
#  3. FRONTEND_URL : les liens des e-mails (confirmation, désabonnement,
#     fiches) sont construits avec FRONTEND_URL. Sans elle, les liens pointent
#     sur http://localhost:5173 et ne fonctionnent que sur CET ordinateur.
#     Voir la section « Tester les liens des e-mails depuis un autre appareil »
#     ci-dessous et dans IMPLEMENTATION.md.

# ─── OPTION C (TESTS hors production — aucun e-mail réel) : serveur de
#     capture local scripts/smtp-capture.ts (port SMTP 1025, interface HTTP
#     8025 : GET /messages, /messages/:id, /messages/:id.html, /messages/:id.txt,
#     DELETE /messages pour remise à zéro). SMTP_NO_AUTH=1 ⇒ pas d'authentification.
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_NO_AUTH=true

# ═══════════════════════════════════════════════════════════════════════════
#  Réglages d'envoi (débit, fiabilité) — valeurs par défaut si omises
# ═══════════════════════════════════════════════════════════════════════════

# Taille d'un lot d'envoi en parallèle
MAIL_BATCH_SIZE=20
# Pause (ms) entre deux lots — respect des quotas SMTP (Gmail ~500/jour)
MAIL_BATCH_PAUSE_MS=1000
# Nouvel essai maximum sur erreur TEMPORAIRE (connection reset, 4xx, timeout)
MAIL_RETRY_ATTEMPTS=3
# Délai de base (ms) entre les essais (backoff : délai × numéro d'essai)
MAIL_RETRY_DELAY_MS=1000
# Longueur maximale du titre injecté dans le SUJET (le corps garde le titre entier)
MAIL_SUBJECT_TITLE_MAX=120

# true = au démarrage en production, Strapi ÉCHOUE BRUYAMMENT si SMTP est
# absent ou si FRONTEND_URL est absent/localhost (défaut : false, bannière
# d'erreur très visible sans arrêt).
MAIL_STRICT=false

# ═══════════════════════════════════════════════════════════════════════════
#  Comptage anonyme des visites (1 visiteur = 1 par jour, heure de Madagascar)
#  Voir IMPLEMENTATION.md §Comptage des visites.
# ═══════════════════════════════════════════════════════════════════════════

# SECRET DE L EMPREINTE DE VISITEUR (OBLIGATOIRE en production, >= 16 car.).
# HMAC-SHA256 de (IP normalisée + jour malgache) : sans ce secret, aucune IP
# n est protégée ; EN PRODUCTION LE COMPTAGE EST REFUS si la variable manque.
# Générez-en un :  openssl rand -hex 32   (ne jamais le committer).
VISITOR_HASH_SECRET=changez-empreinte-visiteur-secret-au-moins-16-caracteres

# FAIRE CONFIANCE AU X-FORWARDED-FOR ? Strapi doit alors être joignable UNIQUEMENT
# via le reverse-proxy / tunnel (sinon un client peut falsifier son adresse).
# false par défaut : en local, l IP de la connexion est utilisée.
TRUST_PROXY=false

# Rétention des empreintes de visiteurs en JOURS (totaux journaliers : sans limite).
VISITOR_RETENTION_DAYS=35

# TEST UNIQUEMENT (ignoré en production) : force le jour de comptage
# VISITOR_JOUR_FIXE=AAAA-MM-JJ — sert à simuler le passage de minuit.
