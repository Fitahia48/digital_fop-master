      "target": "api::type-corps.type-corps",
      "inversedBy": "corps"
    },
    "date_creation": {
      "type": "date",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["actif", "inactif"],
      "default": "actif"
    },
    "fichier": {
      "type": "media",
      "multiple": false
    },
    "pdf_file": {
      "type": "media",
      "multiple": false
    },
    "visits": {
      "type": "integer",
      "default": 0
    },
    "telechargements": {
      "type": "integer",
      "default": 0
    }
  }
