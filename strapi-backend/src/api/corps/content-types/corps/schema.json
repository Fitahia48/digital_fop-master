{
  "kind": "collectionType",
  "collectionName": "strapi_corps",
  "info": {
    "singularName": "corps",
    "pluralName": "organismes",
    "displayName": "Corps",
    "description": "Corps/organismes rattachés (ancienne table SQL `corps`)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
