{
  "kind": "collectionType",
  "collectionName": "strapi_demarche_timeline",
  "info": {
    "singularName": "demarche-timeline",
    "pluralName": "demarche-timelines",
    "displayName": "Démarche — timeline",
    "description": "Journal des changements de statut d'une démarche. Append-only : création seule, jamais de modification/suppression (ancienne table SQL `demarche_timeline`)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "demarche": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::demarche.demarche",
      "inversedBy": "timeline"
    },
    "statut": {
      "type": "enumeration",
      "enum": ["soumise", "en_cours", "traitee", "rejetee"],
      "required": true
    },
    "commentaire": {
      "type": "text"
    },
    "modifie_par": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "timeline_edits"
    }
  }
}