{
  "kind": "collectionType",
  "collectionName": "strapi_demarches",
  "info": {
    "singularName": "demarche",
    "pluralName": "demarches",
    "displayName": "Démarche",
    "description": "Démarches en ligne des usagers (ancienne table SQL `demarches`)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "type_demarche": {
      "type": "enumeration",
      "enum": ["copie_certifiee", "attestation", "demande_information", "autre"],
      "required": true
    },
    "objet": {
      "type": "text",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "demarches"
    },
    "document": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::document.document",
      "inversedBy": "demarches"
    },
    "statut": {
      "type": "enumeration",
      "enum": ["soumise", "en_cours", "traitee", "rejetee"],
      "default": "soumise"
    },
    "commentaire_admin": {
      "type": "text"
    },
    "numero_dossier": {
      "type": "string",
      "unique": true
    },
    "type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::type-demarche.type-demarche",
      "inversedBy": "demarches"
    },
    "direction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::direction.direction",
      "inversedBy": "demarches"
    },
    "agent_affecte": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "demarches_affectees"
    },
    "date_limite": {
      "type": "date"
    },
    "donnees_specifiques": {
      "type": "json"
    },
    "pieces_jointes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::demarche-piece-jointe.demarche-piece-jointe",
      "mappedBy": "demarche"
    },
    "timeline": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::demarche-timeline.demarche-timeline",
      "mappedBy": "demarche"
    }
  }
}